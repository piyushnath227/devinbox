# ============================================================================
# DevInbox configuration.  Copy to .env and edit:  cp .env.example .env
#   * Production (docker-compose.yml):   fill the "REQUIRED" block.
#   * Local dev  (docker-compose.dev.yml or plain uvicorn): defaults just work.
# Anything you leave blank can usually be set later in the dashboard instead.
# ============================================================================

# ---- REQUIRED for production ------------------------------------------------
# Signs sessions and encrypts stored API keys.  Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# BACK THIS UP: without it, stored API keys cannot be decrypted after a restore.
SECRET_KEY=change-this-to-a-random-secret-key
# Postgres password (use letters/digits, e.g. `openssl rand -hex 24`; it goes into a URL).
POSTGRES_PASSWORD=
# Public hostname for automatic HTTPS (DNS A record must point at this server).
# Leave as "localhost" for a local self-signed setup.
DOMAIN=localhost
# Claim the dashboard at startup so nobody else can set the admin password first (12+ chars).
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Database ----------------------------------------------------------------
# SQLite is the zero-config default for local dev. docker-compose.yml builds a
# Postgres URL from POSTGRES_PASSWORD; override only to use an external database
# (e.g. a managed/free-tier Postgres):  postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/devinbox.db
# Where encrypted API keys live: auto (Postgres -> database, SQLite -> files) | db | files
SECRETS_BACKEND=auto
KEYS_DIR=./data/keys

# ---- Queue ---------------------------------------------------------------------
# Redis + RQ workers: persistent, retried, scales by adding workers. Blank = simple
# in-process queue (dev only; jobs are lost on restart).
REDIS_URL=
MAX_JOBS_PER_MINUTE=20

# ---- LLM (any OpenAI-compatible provider) ------------------------------------
# Easiest: leave all blank and pick a provider + paste a key in the dashboard.
# Presets: qwen | gemini | groq | openrouter | openai | ollama (local, free) | custom
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_FALLBACK_MODELS=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=4

# ---- GitHub ------------------------------------------------------------------
# Webhook secret configured on your GitHub webhook (also settable in the dashboard).
WEBHOOK_SECRET=

# ---- Audit-trail archive -------------------------------------------------------
# auto (S3 if configured, else local disk) | none | local | s3.  Works with AWS S3,
# Cloudflare R2, Supabase Storage, Backblaze B2, MinIO (docker-compose.minio.yml), ...
AUDIT_ARCHIVE_BACKEND=auto
AUDIT_ARCHIVE_LOCAL_DIR=./data/audit
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ADDRESSING_STYLE=auto

# ---- Networking / misc ---------------------------------------------------------
# Comma-separated proxy IPs whose X-Forwarded-For is trusted (docker-compose.yml sets this for Caddy).
TRUSTED_PROXY_IPS=
# Origins allowed to call the API cross-origin. Blank unless something outside the dashboard needs it.
CORS_ALLOWED_ORIGINS=
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Only labeled issues are admitted automatically; manual dashboard runs remain available.
AGENT_REQUIRED_LABEL=devinbox
